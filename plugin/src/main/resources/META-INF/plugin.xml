<idea-plugin>
  <id>com.idectl.lifecycle</id>
  <name>idectl IDE Lifecycle</name>
  <vendor>idectl</vendor>
  <description>Expose IDE run configuration lifecycle state to the MCP server.</description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>com.intellij.mcpServer</depends>
  <depends optional="true" config-file="rust.xml">com.jetbrains.rust</depends>
  <extensions defaultExtensionNs="com.intellij">
    <mcpServer.mcpToolset implementation="com.idectl.ide.Lifecycle"/>
  </extensions>
  <projectListeners>
    <listener class="com.idectl.ide.Listener" topic="com.intellij.execution.ExecutionListener"/>
  </projectListeners>
</idea-plugin>
